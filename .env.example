# Weights & Biases Configuration
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=moodnote-ai
WANDB_ENTITY=your_team_name

# Model Configuration
MODEL_PATH=models/best_model
MODEL_NAME=vinai/phobert-base-v2

# Training Configuration
DEVICE=cuda  # or cpu
BATCH_SIZE=16
LEARNING_RATE=3e-5
NUM_EPOCHS=5

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# MongoDB (Training Data)
# Dùng Docker: chạy `docker-compose up -d` rồi giữ URL mặc định bên dưới
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=moodnote_training

# Synthetic Data Generation (OpenRouter / HuggingFace)
OPENROUTER_API_KEY=your_openrouter_api_key_here
HF_TOKEN=your_huggingface_token_here